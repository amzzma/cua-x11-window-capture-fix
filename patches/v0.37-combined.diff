+// ── compositor (XComposite) window capture ────────────────────────────────
+
+/// Own connection used only for compositor-backed window capture.
+struct CompositeSession {
+    display: String,
+    conn: x11rb::rust_connection::RustConnection,
+    pixels: PixelCatalog,
+    screen_num: usize,
+}
+
+impl CompositeSession {
+    fn connect(display: String) -> Result<Self> {
+        use x11rb::protocol::composite::ConnectionExt as _;
+
+        let (conn, screen_num) = x11rb::rust_connection::RustConnection::connect(Some(&display))
+            .map_err(|e| anyhow!("XComposite connect: {e}"))?;
+        let pixels = PixelCatalog::from_setup(conn.setup());
+        conn.composite_query_version(0, 4)
+            .map_err(|e| anyhow!("composite_query_version request: {e}"))?
+            .reply()
+            .map_err(|e| anyhow!("XComposite extension unavailable: {e}"))?;
+        Ok(Self {
+            display,
+            conn,
+            pixels,
+            screen_num,
+        })
+    }
+
+    /// Capture the client content from the compositor's redirected frame
+    /// pixmap. `Ok(None)` means no ancestor is redirected by a compositing
+    /// manager, so the caller falls back to direct drawable capture.
+    fn capture_raw(&mut self, xid: u64) -> Result<Option<RawFrame>> {
+        use x11rb::protocol::composite::ConnectionExt as _;
+        use x11rb::protocol::xproto::{ConnectionExt as _, ImageFormat};
+
+        let client = xid_to_window(xid)?;
+        let attrs = self
+            .conn
+            .get_window_attributes(client)
+            .map_err(|e| anyhow!("get_window_attributes request: {e}"))?
+            .reply()
+            .map_err(|e| anyhow!("get_window_attributes reply: {e}"))?;
+        if attrs.visual == 0 {
+            // InputOnly windows have no pixels.
+            return Ok(None);
+        }
+        let geom = self
+            .conn
+            .get_geometry(client)
+            .map_err(|e| anyhow!("get_geometry request: {e}"))?
+            .reply()
+            .map_err(|e| anyhow!("get_geometry reply: {e}"))?;
+        let w = u32::from(geom.width);
+        let h = u32::from(geom.height);
+        checked_capture_dimensions(w, h)?;
+
+        let Some(frame) = redirected_ancestor(&self.conn, client, self.screen_num)? else {
+            return Ok(None);
+        };
+        // The frame pixmap includes the window-manager decoration; crop it back
+        // to the client rectangle so coordinates match the other backends.
+        let offset = self
+            .conn
+            .translate_coordinates(client, frame, 0, 0)
+            .map_err(|e| anyhow!("translate_coordinates request: {e}"))?
+            .reply()
+            .map_err(|e| anyhow!("translate_coordinates reply: {e}"))?;
+        if offset.dst_x < 0 || offset.dst_y < 0 {
+            bail!("client origin is outside its compositor frame");
+        }
+        let pixmap = self
+            .conn
+            .generate_id()
+            .map_err(|e| anyhow!("generate_id for composite capture: {e}"))?;
+        self.conn
+            .composite_name_window_pixmap(frame, pixmap)
+            .map_err(|e| anyhow!("composite_name_window_pixmap request: {e}"))?
+            .check()
+            .map_err(|e| anyhow!("composite_name_window_pixmap reply: {e}"))?;
+        let image = self
+            .conn
+            .get_image(
+                ImageFormat::Z_PIXMAP,
+                pixmap,
+                offset.dst_x,
+                offset.dst_y,
+                geom.width,
+                geom.height,
+                !0u32,
+            )
+            .map_err(|e| anyhow!("get_image request: {e}"))?
+            .reply();
+        self.conn
+            .free_pixmap(pixmap)
+            .map_err(|e| anyhow!("free_pixmap request: {e}"))?;
+        let image = image.map_err(|e| anyhow!("get_image reply: {e}"))?;
+
+        if !matches!(image.depth, 16 | 24 | 32) {
+            bail!("Unsupported depth: {}", image.depth);
+        }
+        Ok(Some(RawFrame {
+            data: image.data,
+            w,
+            h,
+            decoder: self
+                .pixels
+                .decoder(w, h, image.depth, attrs.visual, |visual| {
+                    query_direct_colors(&self.conn, client, visual)
+                })?,
+        }))
+    }
+}
+
+/// Walk up from `client` to the nearest ancestor redirected by the compositor.
+///
+/// X11 window managers reparent clients into a frame window; the compositing
+/// manager redirects that frame rather than the client, so `NameWindowPixmap`
+/// on the client yields `BadMatch`. Returns `None` when no ancestor is
+/// redirected (no compositing manager, compositing disabled, or a window the
+/// compositor left unredirected). Each failed probe is a checked request whose
+/// error x11rb contains, so the connection stays usable.
+fn redirected_ancestor(
+    conn: &x11rb::rust_connection::RustConnection,
+    client: u32,
+    screen_num: usize,
+) -> Result<Option<u32>> {
+    use x11rb::protocol::composite::ConnectionExt as _;
+    use x11rb::protocol::xproto::ConnectionExt as _;
+
+    let root = conn.setup().roots[screen_num].root;
+    let mut current = client;
+    loop {
+        // CompositeNameWindowPixmap names a caller-allocated pixmap id and has a
+        // void reply, so a failed probe is a checked RequestError, not a reply.
+        let probe_pixmap = conn
+            .generate_id()
+            .map_err(|e| anyhow!("generate_id for composite probe: {e}"))?;
+        if conn
+            .composite_name_window_pixmap(current, probe_pixmap)
+            .map_err(|e| anyhow!("composite_name_window_pixmap request: {e}"))?
+            .check()
+            .is_ok()
+        {
+            return Ok(Some(current));
+        }
+        if current == root {
+            return Ok(None);
+        }
+        let parent = conn
+            .query_tree(current)
+            .map_err(|e| anyhow!("query_tree request: {e}"))?
+            .reply()
+            .map_err(|e| anyhow!("query_tree reply: {e}"))?
+            .parent;
+        if parent == 0 || parent == current {
+            return Ok(None);
+        }
+        current = parent;
+    }
+}
+
+fn composite_state() -> &'static Mutex<Option<CompositeSession>> {
+    static STATE: OnceLock<Mutex<Option<CompositeSession>>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(None))
+}
+
+fn capture_via_composite(xid: u64) -> Result<Vec<u8>> {
+    let display = current_display();
+    let mut guard = lock_mutex(composite_state());
+
+    ensure_composite_ready(&mut guard, &display)
+        .map_err(|e| anyhow!("XComposite connect: {e:#}"))?;
+
+    let first = match guard.as_mut() {
+        Some(session) => session.capture_raw(xid),
+        None => Err(anyhow!("internal: XComposite session missing after ensure")),
+    };
+
+    let frame = match first {
+        Ok(Some(frame)) => frame,
+        Ok(None) => bail!("window is not redirected by a compositing manager"),
+        Err(first_err) => {
+            // Cached connection failure → reconnect once.
+            *guard = None;
+            ensure_composite_ready(&mut guard, &display)
+                .map_err(|e| anyhow!("XComposite reconnect after error ({first_err:#}): {e:#}"))?;
+            let session = guard
+                .as_mut()
+                .ok_or_else(|| anyhow!("XComposite session missing after reconnect"))?;
+            match session.capture_raw(xid).map_err(|e| {
+                anyhow!("XComposite capture failed after reconnect (first: {first_err:#}): {e:#}")
+            })? {
+                Some(frame) => frame,
+                None => bail!("window is not redirected by a compositing manager"),
+            }
+        }
+    };
+
+    drop(guard);
+    packed_zpixmap_to_png(&frame.data, frame.w, frame.h, frame.decoder)
+}
+
+fn ensure_composite_ready(guard: &mut Option<CompositeSession>, display: &str) -> Result<()> {
+    if let Some(session) = guard.as_ref() {
+        if session.display == display {
+            return Ok(());
+        }
+    }
+    *guard = None;
+    *guard = Some(CompositeSession::connect(display.to_string())?);
+    Ok(())
+}
